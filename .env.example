# Environment variables for the ASSET CREATION pipeline only.
# NONE of these are required to run EngineDataFlow. The app runs fully offline
# with procedural geometry when no keys are present.

# Meshy 3D generation (used only when generating GLB assets, never at runtime)
MESHY_API_KEY=
MESHY_CREDIT_BUDGET=

# Set to true only if you explicitly allow uploading cropped reference images
# to an external 3D service. Default: do NOT upload anything.
ALLOW_EXTERNAL_REFERENCE_UPLOAD=false
